{
  "schema": "legra-simu5g-radio-export-v1",
  "source": "Simu5G LteMacEnb ALLBANDS feedback",
  "rate_source": "Simu5G NrAmc::computeBitsPerRbBackground",
  "rate_formula": "rate_kbps = tbs_bits_per_slot / slot_duration_ms",
  "slot_duration_ms": 1.0,
  "snapshot_period_s": 0.1,
  "snapshot_rule": "latest complete UE feedback in each floor-aligned time bin; if multiple gNB observations remain for one UE/time bin, keep the latest raw timestamp",
  "rb_budget_ratio": 0.28,
  "rb_budget_rule": "round(total_logical_bands * ratio), clipped to [1, total]",
  "previous_quality": 3,
  "previous_quality_mode": "deterministic_controller_heterogeneous",
  "previous_quality_source": "deterministic_heterogeneous_adaptation_controller_from_radio_capacity_and_cell_load",
  "rb_abstraction": "Simu5G logical band",
  "sinr_source": "not_exported_in_p3_4",
  "ue_id_source": "SUMO_external_id_joined_by_OMNeT_module_path",
  "collapsed_same_bin_duplicates": 0,
  "quality_controller": {
    "type": "ewma_buffer_adaptation_heterogeneous",
    "bitrates_kbps": [
      200.0,
      550.0,
      1500.0,
      3000.0,
      5800.0,
      7500.0
    ],
    "effective_capacity_rule": "sum(top rb_available per-band rates) divided by active UE count in the same (timestamp, serving_gnb) snapshot",
    "ewma_rule": "per-UE alpha profile; uniform mode uses 0.65 * previous + 0.35 * current",
    "buffer_range_s": [
      0.0,
      12.0
    ],
    "initial_quality": {
      "conservative": 0,
      "balanced": 1,
      "aggressive": 2
    },
    "initial_buffer_s": {
      "conservative": 3.2,
      "balanced": 2.0,
      "aggressive": 1.1
    }
  },
  "postprocess_variant": {
    "name": "p3_6m2_positive_family_decoy_bundle",
    "base_bundle": "p3_6i2_coupled_bundle",
    "target_family": "0|1|15|2|3|4|5@gnb_1",
    "window_s": [
      43.4,
      43.9
    ],
    "primary_weak_ue_id": "15",
    "decoy_ue_id": "4",
    "intent": "preserve the real positive-gain ue15 isolation regime while injecting ue4 as a lighter history-driven decoy for learner-side ambiguity",
    "rate_transforms": {
      "ue4": {
        ">=1128_kbps": 0.985,
        ">=984_kbps": 0.98,
        "else": 0.99
      }
    },
    "history_patterns": {
      "ue15": "reinforced_recent_decline_primary_weak",
      "ue4": "recent_decline_light_decoy"
    }
  }
}
