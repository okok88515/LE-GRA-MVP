# Real Simu5G radio exports are source data that cannot be regenerated by the
# Python benchmark alone. Keep them versioned, but outside normal Git objects.
real_simu5g_data/raw_radio.csv filter=lfs diff=lfs merge=lfs -text
real_simu5g_data/mid_raw_radio.csv filter=lfs diff=lfs merge=lfs -text
real_simu5g_data/high_raw_radio.csv filter=lfs diff=lfs merge=lfs -text

# Multi-seed archives are compressed per run and remain independently
# addressable. Git LFS keeps future seed expansion out of normal Git history.
real_simu5g_multiseed_data/**/*.csv.gz filter=lfs diff=lfs merge=lfs -text
