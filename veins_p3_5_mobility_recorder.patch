+void recordLeGraSumoMobility(omnetpp::simtime_t timestamp,
+        const std::string& externalId, const char *modulePath,
+        const inet::Coord& position, double speed)
+{
+    const char *outputPath = std::getenv("LEGRA_MOBILITY_RAW_CSV");
+    if (outputPath == nullptr || outputPath[0] == '\0')
+        return;
+    if (externalId.find(',') != std::string::npos)
+        throw omnetpp::cRuntimeError("SUMO vehicle ID contains a comma: %s", externalId.c_str());
+
+    static std::ofstream output;
+    static std::string activePath;
+    if (!output.is_open()) {
+        activePath = outputPath;
+        output.open(activePath, std::ios::out | std::ios::trunc);
+        if (!output)
+            throw omnetpp::cRuntimeError("Cannot open LE-GRA mobility recorder output: %s", outputPath);
+        output << "timestamp_s,sumo_vehicle_id,ue_module_path,x_m,y_m,speed_mps\n";
+        output << std::setprecision(15);
+    }
+    else if (activePath != outputPath) {
+        throw omnetpp::cRuntimeError("LEGRA_MOBILITY_RAW_CSV changed during the simulation");
+    }
+
+    output << timestamp.dbl() << ','
+           << externalId << ','
+           << modulePath << ','
+           << position.x << ','
+           << position.y << ','
+           << speed << '\n';
+    output.flush();
+}
+
+} // namespace
+
