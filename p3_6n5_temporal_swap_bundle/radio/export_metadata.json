    "window_start_s": 25.8,
    "window_end_s": 29.9,
    "swap_start_s": 27.9,
    "intent": "start from ue5-isolation and create a late-window swap so the weak identity moves from ue5 to ue4, creating temporal weak-order ambiguity",
    "early_primary_weak_ue_id": "5",
